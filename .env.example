# ============================================================
# EmailVerifier - Environment Variables Template
# ============================================================
# Copy this file to .env.local for development
# Set these variables in Vercel dashboard for production

# ── Next.js ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Get from: https://supabase.com → Project Settings → Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Cloudinary ───────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Gmail SMTP ───────────────────────────────────────────────
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Upstash Redis ────────────────────────────────────────────
# Get from: https://upstash.com → Redis → Connect
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# ── Legacy Backend (Docker) ──────────────────────────────────
# Used only when running with docker-compose
APP_NAME=EmailVerifier SaaS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
POSTGRES_PASSWORD=yourStrongDatabasePassword
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600
CREDITS_PER_VERIFICATION=1
DEFAULT_USER_CREDITS=10
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=YourStrongAdminPassword123!
VITE_API_URL=/api
