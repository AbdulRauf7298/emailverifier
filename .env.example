# App
APP_NAME=EmailVerifier SaaS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
POSTGRES_PASSWORD=yourStrongDatabasePassword
DATABASE_URL=postgresql+asyncpg://postgres:yourStrongDatabasePassword@db:5432/emailverifier

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# WooCommerce Webhook
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-webhook-secret

# Credits
CREDITS_PER_VERIFICATION=1
DEFAULT_USER_CREDITS=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Superadmin Account
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=YourStrongAdminPassword123!

# Frontend (Vite)
VITE_API_URL=/api
VITE_WOOCOMMERCE_URL=https://yourwordpresssite.com/shop
